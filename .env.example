# Copy to .env and fill with output from `npm run keys`.
# Values must be at least 32 bytes, encoded as base64url. Do not commit .env.
GAME_SIGNING_KEY=
GAME_RNG_KEY=

# Browser origin allowed to call the local API. Not used as authentication.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Local API port. The Vite dev server proxies /api here.
PORT=8787
